{
  "name": "lektor-vscode",
  "displayName": "Lektor",
  "version": "0.0.1",
  "private": true,
  "engines": { "vscode": "^1.85.0" },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "lektor.review", "title": "Lektor: Review Current File" }
    ]
  },
  "scripts": {
    "build": "esbuild extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js"
  }
}